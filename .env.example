APP_NAME="Laravel CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Values below match the services in docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CRM -------------------------------------------------------------------
# Role for new sign-ups: admin|manager|sales|viewer
CRM_DEFAULT_ROLE=viewer

# --- Attachments -----------------------------------------------------------
# "media" = private local disk, "azure" = Azure Blob Storage (Azurite locally).
MEDIA_DISK=azure
MEDIA_MAX_FILE_SIZE_MB=20
# "stream" proxies downloads through the app; "redirect" uses short-lived SAS URLs.
MEDIA_DOWNLOAD_STRATEGY=stream
# Livewire's temporary uploads. Leave empty for the local disk; use "azure" when
# running more than one web replica.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=

# Azurite's well-known development account (not a secret).
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
AZURE_STORAGE_CONTAINER=media
# On Azure use a managed identity instead of a connection string:
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CREDENTIAL=managed_identity
# AZURE_STORAGE_CLIENT_ID=

VITE_APP_NAME="${APP_NAME}"
