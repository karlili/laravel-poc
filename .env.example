APP_NAME="Laravel CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Values below match the services in compose.yaml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CRM -------------------------------------------------------------------
# Role for new sign-ups and first-time Microsoft sign-ins: admin|manager|sales|viewer
CRM_DEFAULT_ROLE=viewer

# --- Attachments -----------------------------------------------------------
# "media" = private local disk, "azure" = Azure Blob Storage (Azurite locally).
MEDIA_DISK=azure
MEDIA_MAX_FILE_SIZE_MB=20
# "stream" proxies downloads through the app; "redirect" uses short-lived SAS URLs.
MEDIA_DOWNLOAD_STRATEGY=stream
# Livewire's temporary uploads. Leave empty for the local disk; use "azure" when
# running more than one web replica.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=

# Azurite's well-known development account (not a secret).
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
AZURE_STORAGE_CONTAINER=media
# On Azure use a managed identity instead of a connection string:
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CREDENTIAL=managed_identity
# AZURE_STORAGE_CLIENT_ID=

# --- Microsoft Entra ID single sign-on (see docs/entra-setup.md) -----------
AUTH_MICROSOFT_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
# Link a first Microsoft sign-in to an existing account with the same email.
SSO_LINK_BY_EMAIL=true
# Accounts linked to Microsoft can no longer use a local password.
SSO_ENFORCE_FOR_LINKED_USERS=true

VITE_APP_NAME="${APP_NAME}"
